{% extends 'base.html.twig' %}

{% block title %}Lise des employés{% endblock %}

{% block body %}

    <main>
        <header>
            <div id="current-user"></div>
            <div id="title-page">
                <h1>Équipe</h1>
            </div>
        </header>
        <div id="content">
            <table id="team-container">
                <thead>
                    <tr>
                    <th>Prénom, Nom</th>
                    <th>Statut</th>
                    <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>
                                <a class="employee-infos" href="{{ path('app_user_update', {id: user.id}) }}">
                                    <div class="employee-avatar">
                                        <div class="avatar">{{ user.firstName|slice(0, 1)|upper }}</div>
                                    </div>
                                    <div class="employee-coords">
                                        <strong>{{ user.firstName }} {{ user.lastName }}</strong>
                                        <span>{{ user.email }}</span>
                                    </div>
                                </a>
                            </td>
                            <td>{{ user.contract.value }}</td>
                            <td>
                                <a class="button button-edit-team" href="{{ path('app_user_update', {id: user.id}) }}">
                                Éditer
                                </a>
                                <form action="{{ path('app_user_remove', {id: user.id}) }}" method="post" style="display: inline;">
                                    <button type="submit" class="button button-delete-team">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %} 
                </tbody>
            </table>
        </div>
    </main>
{% endblock %}
