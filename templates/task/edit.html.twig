{% extends 'base.html.twig' %}

{% block title %}Modifier un tâche{% endblock %}

{% block body %}
    <main>
    <header>
        <div id="current-user"></div>
        <div id="title-page">
            <h1>{{ task.title }}</h1>
        </div>
    </header>
    <div id="content">
        {{ include('task/_form.html.twig', {
            button_label: 'Modifier'
        }) }}
        <form action="{{ path('app_task_remove', {id: task.id}) }}" method="post" >
            <button type="submit" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette tâche ?')" class="delete-task">
                Supprimer la tâche
            </button>
        </form>
    </div>
    </main>
{% endblock %}
